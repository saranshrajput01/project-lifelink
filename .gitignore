# ─── Project LIFELINK .gitignore ───

# ─── Python ─────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/

# ─── Node.js ────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Environment & Secrets ──────
.env
.env.*
!.env.example
# Frontend production API URL is a PUBLIC value (inlined into the browser
# bundle anyway); commit it so Vercel builds always point at the live backend.
!frontend/.env.production
*.pem
*.key

# ─── IDEs ───────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Docker ─────────────────────
docker-compose.override.yml

# ─── Testing ────────────────────
.coverage
htmlcov/
.pytest_cache/

# ─── Build Outputs ──────────────
frontend/dist/
*.log

# ─── ML Models (large files) ────
*.pkl
*.onnx
*.h5
*.pt
ml-notebooks/.ipynb_checkpoints/
# Keep the trained risk models in the repo (small, needed for the demo to run on clone)
!backend/app/ml/models_store/*.joblib

# ─── Data files ─────────────────
*.parquet
data/
!scripts/init-db.sql
# Keep the real training datasets in the repo (demo: proves models trained on real data)
!backend/app/ml/datasets/*.csv
!backend/app/ml/datasets/*.data
!backend/app/ml/datasets/*.arff

# ─── Large wheel cache (never commit — 400MB+, rebuilt by Docker) ───
backend/wheels/

# ─── Terraform ──────────────────
infra/.terraform/
infra/.terraform.lock.hcl
infra/terraform.tfstate
infra/terraform.tfstate.*
infra/terraform.tfvars
infra/*.tfplan

# ─── Archives ───────────────────
*.rar
*.zip
