# ─── Project LIFELINK — Environment Variables ───
# Copy this to .env and fill in your values.

APP_NAME="Project LIFELINK"
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://lifelink:lifelink@localhost:5432/lifelink_db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=GENERATE-A-RANDOM-SECRET-KEY-HERE

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=lifelink-documents

OPENAI_API_KEY=your-key-here
GEMINI_API_KEY=your-key-here

# ─── Groq (active AI provider) — add up to 7 keys for auto-rotation ───
GROQ_API_KEY=your-groq-key-here
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MODEL_STRONG=qwen/qwen3.8-27b

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
